<?xml version="1.0" encoding="utf-8"?>
<!-- FileProvider paths: internal files + cache only. Never expose downloads
     storage or app-private secrets through this provider. -->
<paths>
    <files-path name="internal" path="." />
    <cache-path name="cache" path="." />
    <!-- API 28 legacy saves land in public Downloads/MVD — map the external
         storage root so Open/Share can hand those files to other apps. Grants
         are intent-scoped (FLAG_GRANT_READ_URI_PERMISSION), never global. -->
    <external-path name="external" path="." />
</paths>
